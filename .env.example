HOST=127.0.0.1
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/novel_anime
DATA_DIR=./data

# --- LLM Provider: "gemini" หรือ "deepseek" ---
# gemini  = ใช้ Gemini native API (มี content policy ภาษาไทย ต้องใช้ CHAR_N workaround)
# deepseek = ใช้ DeepSeek V3 (ไม่มี content policy ภาษาไทย แนะนำสำหรับนิยายแฟนตาซี)
LLM_PROVIDER=gemini

# --- Gemini ---
# LLM_API_KEY=AIza...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL=gemini-2.5-flash

# --- DeepSeek ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ค่าที่ใช้จริง (uncomment อันที่ต้องการ แล้ว comment อีกอัน)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-2.5-flash

# --- Fallback LLM (optional) ---
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_MODEL=

RH_BASE_URL=https://www.runninghub.ai
RH_API_KEY=
RH_MAX_CONCURRENT_IMAGE=2
RH_MAX_CONCURRENT_VIDEO=1
